# Prisma Postgres connection string.
# Provision a database in your Prisma Console account (https://console.prisma.io)
# or via the `prisma-cloud` MCP server, then copy the direct connection string here.
# The real value lives in `.env` (git-ignored).
# Use `sslmode=verify-full` (not `require`) — `require` triggers a `pg` deprecation
# warning on every boot; `verify-full` is the same behaviour, stated explicitly.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full"

# Public origin of the site — absolute URLs in the sitemap, RSS feed and
# metadata. Set to the production origin on the host (e.g. https://ocunioenergy.com).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (https://resend.com) — transactional email (staff alerts, order
# confirmations, password reset). Leave RESEND_API_KEY blank to disable sending
# in dev — every send is logged as "[email] skipped" instead of failing.
# Without a verified domain, use Resend's shared sandbox address as RESEND_FROM
# ("Ocunio Energy <onboarding@resend.dev>") — note sandbox mode only delivers to
# the email address that owns the Resend account. Switch to
# "Ocunio Energy <noreply@ocunioenergy.com>" once that domain is DNS-verified.
RESEND_API_KEY=""
RESEND_FROM="Ocunio Energy <noreply@ocunioenergy.com>"
# Optional extra recipient for staff lead/order alerts (DB admins always get them).
STAFF_NOTIFICATION_EMAIL=""

# Prisma Object Store (S3-compatible) — bucket for uploaded images (blog cover,
# product photos/gallery). Create via the Prisma Console / prisma-cloud MCP
# (create_object_store_bucket + create_object_store_bucket_key).
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Stripe (https://dashboard.stripe.com/apikeys) — Checkout, Tax, Invoicing.
# Prefer a restricted key (rk_) with only the permissions this app needs once
# you go live; a plain secret key (sk_) is fine for local test-mode development.
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` in dev,
# or the Dashboard webhook endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=""
