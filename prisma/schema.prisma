// Prisma schema — https://pris.ly/d/prisma-schema
// Run `npm run db:migrate` after editing models.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// A sales / enquiry lead. The `AdminLead` type in src/lib/admin-leads.ts is the
/// UI-facing shape; src/lib/leads-dal.ts maps between them.
model Lead {
  id                    String     @id @default(cuid())
  firstName             String
  lastName              String
  phone                 String
  email                 String
  jobTitle              String?
  companyName           String?
  postcode              String?
  areaOfEnquiry         String
  reasonForEnquiry      String
  paidServicePlans      Boolean    @default(false)
  futureCommunications  Boolean    @default(false)
  additionalInformation String?
  status                LeadStatus @default(New)
  submittedAt           DateTime   @default(now())
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  // Set when the enquiry was submitted by a signed-in customer.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // OZEV grant / installation journey — only populated once a lead is Won.
  installStage String?
  surveyDate   DateTime?
  grantStatus  String?
  installDate  DateTime?
  engineer     String?

  @@index([status])
  @@index([submittedAt])
  @@index([userId])
}

enum LeadStatus {
  New
  Contacted
  Quoted
  Won
  Lost
}

/// A charger order placed through checkout. No online payment — the team
/// confirms payment and books installation, tracked via `status`.
model Order {
  id        String      @id @default(cuid())
  reference String      @unique
  status    OrderStatus @default(Pending)

  firstName String
  lastName  String
  email     String
  phone     String
  address   String
  postcode  String
  notes     String?

  subtotal Int // whole GBP — the catalog is priced in integer pounds

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String // catalog id, or an extra's id
  category  String // residential | commercial | accessories | extra
  name      String // snapshot at time of order
  unitPrice Int? // whole GBP; null for quote-only accessories
  quantity  Int
  options   Json? // { cableLength?, installation? }

  @@index([orderId])
}

enum OrderStatus {
  Pending
  Confirmed
  Scheduled
  Installed
  Cancelled
}

/// A catalog product. `id` is the URL slug. The `Product` / `CommercialProduct`
/// / `AccessoryProduct` / `ProductDetail` types in src/lib/*.ts are the UI-facing
/// shapes; src/lib/catalog-dal.ts maps a row to them.
model Product {
  id           String          @id
  category     ProductCategory
  name         String
  brand        String
  colour       String
  cardImage    String
  tags         String[]        @default([])
  variantGroup String?
  active       Boolean         @default(true)
  featured     Boolean         @default(false)
  sortOrder    Int             @default(0)

  // chargers (Residential + Commercial)
  spec           String?
  connectionType String?
  cableLength    String?
  powerOutput    String?
  price          Int?

  // Residential only
  cableLengthOptions String[] @default([])
  compatibleTariffs  String[] @default([])

  // Accessory only
  style         String?
  phase         String?
  lengthOptions String[] @default([])

  // detail-page content (all categories)
  tagline     String?
  gallery     String[] @default([])
  description String[] @default([])
  features    String[] @default([])
  specs       Json?
  warranty    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, active, sortOrder])
  @@index([variantGroup])
}

enum ProductCategory {
  Residential
  Commercial
  Accessory
}

/// A blog article. `id` is the URL slug (caller-supplied, like `Product`).
/// `bodyHtml` is sanitised HTML from the Tiptap editor — see src/lib/blog/.
model Post {
  id          String   @id
  title       String
  excerpt     String
  coverImage  String
  author      String   @default("Ocunio Energy")
  tags        String[] @default([])
  bodyHtml    String
  published   Boolean  @default(false)
  publishedAt DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt])
}

// ─── Better Auth ────────────────────────────────────────────────────────────
// Generated by `npx @better-auth/cli generate` (email/password + Google +
// admin plugin). Regenerate after changing the auth config in src/lib/auth.ts,
// then run `npm run db:migrate`.

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  // Customer profile fields (Better Auth additionalFields — see src/lib/auth.ts)
  phone         String?
  address       String?
  postcode      String?
  sessions      Session[]
  accounts      Account[]
  leads         Lead[]
  orders        Order[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
